NODE_ENV=development
PORT=5000
# Comma-separated frontend origins. Add your deployed frontend URL in production.
CLIENT_URL=http://localhost:5175
# Use a long random value (at least 32 characters). Changing it invalidates existing login tokens.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>
# Set true only when running behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false
